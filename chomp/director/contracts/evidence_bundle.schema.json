{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chomp-Chomp evidence bundle v1",
  "type": "object",
  "properties": {
    "schema_version": {"const": "chomp-evidence/1"},
    "evidence_hash": {"$ref": "#/$defs/sha256"},
    "source": {
      "type": "object",
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "case_id": {"$ref": "#/$defs/id"},
        "split": {"type": "string", "enum": ["development", "holdout"]},
        "rights_ref": {"type": "string", "minLength": 1, "maxLength": 280},
        "duration_ms": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "audio_stream": {"type": "integer", "minimum": 0},
        "ffmpeg_version": {"type": "string", "minLength": 1, "maxLength": 250}
      },
      "required": [
        "sha256",
        "case_id",
        "split",
        "rights_ref",
        "duration_ms",
        "width",
        "height",
        "audio_stream",
        "ffmpeg_version"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 0},
        "anchor_ms": {"type": "integer", "minimum": 0}
      },
      "required": ["id", "start_ms", "end_ms", "anchor_ms"],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {"start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 0}},
      "required": ["start_ms", "end_ms"],
      "additionalProperties": false
    },
    "modality_flags": {
      "type": "object",
      "properties": {
        "transcript": {"type": "boolean"},
        "audio": {"type": "boolean"},
        "chat": {"type": "boolean"},
        "visual": {"type": "boolean"}
      },
      "required": ["transcript", "audio", "chat", "visual"],
      "additionalProperties": false
    },
    "utterances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "text": {"type": "string", "minLength": 1, "maxLength": 1200},
          "speaker_id": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 80},{"type": "null"}]},
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "start_ms": {"type": "integer", "minimum": 0},
                "end_ms": {"type": "integer", "minimum": 0},
                "text": {"type": "string", "minLength": 1, "maxLength": 128},
                "confidence": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1},{"type": "null"}]}
              },
              "required": ["id", "start_ms", "end_ms", "text", "confidence"],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 250
          }
        },
        "required": ["id", "start_ms", "end_ms", "text", "speaker_id", "words"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 80
    },
    "audio_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "kind": {"type": "string", "minLength": 1, "maxLength": 64},
          "strength": {"type": "number", "minimum": 0, "maximum": 1},
          "measurement": {"type": "string", "minLength": 1, "maxLength": 400}
        },
        "required": ["id", "start_ms", "end_ms", "kind", "strength", "measurement"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 80
    },
    "chat_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "kind": {"type": "string", "minLength": 1, "maxLength": 64},
          "strength": {"type": "number", "minimum": 0, "maximum": 1},
          "measurement": {"type": "string", "minLength": 1, "maxLength": 400}
        },
        "required": ["id", "start_ms", "end_ms", "kind", "strength", "measurement"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 80
    },
    "visual_samples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "requested_ms": {"type": "integer", "minimum": 0},
          "at_ms": {"type": "integer", "minimum": 0},
          "path": {"type": "string", "pattern": "^frames/f[1-8]\\.png$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "scene_id": {"anyOf": [{"$ref": "#/$defs/id"},{"type": "null"}]},
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "subject_id": {"$ref": "#/$defs/id"},
                "kind": {"type": "string", "enum": ["scene", "camera", "action", "person", "screen_evidence", "hud"]},
                "box": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "origin": {"type": "string", "enum": ["source_bounds", "operator_annotation", "existing_detector"]},
                "verified": {"type": "boolean"}
              },
              "required": ["id", "subject_id", "kind", "box", "confidence", "origin", "verified"],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 12
          }
        },
        "required": ["id", "requested_ms", "at_ms", "path", "sha256", "width", "height", "scene_id", "regions"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 8
    }
  },
  "required": [
    "schema_version",
    "evidence_hash",
    "source",
    "candidate",
    "context",
    "modality_flags",
    "utterances",
    "audio_events",
    "chat_events",
    "visual_samples"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
