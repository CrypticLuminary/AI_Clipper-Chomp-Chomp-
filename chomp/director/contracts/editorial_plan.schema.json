{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chomp-Chomp editorial plan v1",
  "type": "object",
  "properties": {
    "schema_version": {"const": "chomp-editorial/1"},
    "decision": {"type": "string", "enum": ["select", "reject", "abstain"]},
    "decision_reason": {"type": "string", "minLength": 1, "maxLength": 600},
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["reaction", "skill", "funny", "failure", "discovery", "argument", "informative", "emotional", "other"]
      },
      "minItems": 0,
      "maxItems": 4
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "modality": {"type": "string", "enum": ["transcript", "audio", "chat", "visual"]},
          "support": {"type": "string", "enum": ["observed", "inferred"]},
          "statement": {"type": "string", "minLength": 1, "maxLength": 320},
          "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "maxItems": 16}
        },
        "required": ["modality", "support", "statement", "evidence_ids"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 12
    },
    "moment": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start_ms": {"type": "integer", "minimum": 0},
            "end_ms": {"type": "integer", "minimum": 0},
            "anchor_ms": {"type": "integer", "minimum": 0},
            "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "maxItems": 16}
          },
          "required": ["start_ms", "end_ms", "anchor_ms", "evidence_ids"],
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "role": {"type": "string", "enum": ["setup", "event", "payoff", "reaction", "other"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 320},
          "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "maxItems": 16}
        },
        "required": ["start_ms", "end_ms", "role", "description", "evidence_ids"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "layout": {
            "type": "string",
            "enum": [
              "split_streamer_main",
              "main_only",
              "streamer_only",
              "evidence_plus_streamer",
              "multi_person",
              "irl_portrait",
              "letterbox_review"
            ]
          },
          "target_subject_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 0, "maxItems": 20},
          "required_region_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 0, "maxItems": 20},
          "crop_behavior": {"type": "string", "enum": ["hold", "pan", "track", "static_manual", "full_frame"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 320},
          "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "maxItems": 16},
          "uncertain": {"type": "boolean"}
        },
        "required": [
          "start_ms",
          "end_ms",
          "layout",
          "target_subject_ids",
          "required_region_ids",
          "crop_behavior",
          "reason",
          "evidence_ids",
          "uncertain"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 12
    },
    "title": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 90},
            "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "maxItems": 16}
          },
          "required": ["text", "evidence_ids"],
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "hook": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {"type": "string", "minLength": 1, "maxLength": 90},
            "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1, "maxItems": 16}
          },
          "required": ["text", "evidence_ids"],
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "captions": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "enum": ["faithful", "verify_speech"]},
        "emphasis_word_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 0, "maxItems": 20}
      },
      "required": ["mode", "emphasis_word_ids"],
      "additionalProperties": false
    },
    "requires_visual_verification": {"type": "boolean"},
    "unresolved": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 320},
      "minItems": 0,
      "maxItems": 10
    },
    "review_status": {"const": "pending"},
    "publish_status": {"const": "disabled"},
    "provenance": {
      "type": "object",
      "properties": {
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"type": "string", "enum": ["text", "frames"]},
        "provider": {"$ref": "#/$defs/id"},
        "model": {"type": "string", "minLength": 1, "maxLength": 100},
        "cli_version": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 100},{"type": "null"}]},
        "prompt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["bundle_sha256", "source_sha256", "mode", "provider", "model", "cli_version", "prompt_sha256"],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "decision",
    "decision_reason",
    "categories",
    "confidence",
    "claims",
    "moment",
    "beats",
    "shots",
    "title",
    "hook",
    "captions",
    "requires_visual_verification",
    "unresolved",
    "review_status",
    "publish_status",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
